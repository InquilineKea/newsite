{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matter Zoo extension envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "kind",
    "producer",
    "sourceSections",
    "parentArtifactIds",
    "family",
    "evidenceLevel",
    "status",
    "claim",
    "payload",
    "sources",
    "validation",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": "matter-zoo-extension/1.0"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,100}$"
    },
    "kind": {
      "enum": [
        "Hypothesis",
        "Design",
        "Calculation",
        "DescriptorProposal",
        "SchemaProposal",
        "Review"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "agent",
        "method",
        "evidence",
        "assumptions",
        "runtimeOverlap"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "string",
          "minLength": 1
        },
        "runtimeOverlap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^S([1-9]|1[0-9]|2[0-7])$"
      }
    },
    "parentArtifactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "family": {
      "enum": [
        "mechanical",
        "tight_binding",
        "photonic",
        "cross_family"
      ]
    },
    "evidenceLevel": {
      "enum": [
        "proposal",
        "simulation",
        "experiment"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "completed",
        "failed",
        "inconclusive"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "controls",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "unrun",
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "controls": {
          "type": "array"
        },
        "limitations": {
          "type": "array"
        }
      }
    },
    "results": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "type": "null"
          },
          "evidenceLevel": {
            "const": "proposal"
          },
          "validation": {
            "properties": {
              "status": {
                "const": "unrun"
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Envelope schema. Run core.js validateExtension or scripts/zoo_expand.py for placeholder, URL, execution and cross-family checks. Scientific review is separate."
}
